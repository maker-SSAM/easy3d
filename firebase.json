{
  "hosting": {
    "site": "easy3d",
    "public": ".",
    "ignore": [
      "firebase.json",
      "storage.rules",
      "**/.*",
      ".git/**",
      ".github/**",
      ".claude/**",
      "**/node_modules/**",
      "USB_제출용/**",
      "홍보자료/**",
      "serve.py",
      "serve.bat",
      "serve.command",
      "designs/gallery-10.html",
      "assets/previews/gallery-10.glb",
      "assets/models/whistle.stl"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'self'"
          }
        ]
      },
      {
        "source": "/festival0*/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/css/festival.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
