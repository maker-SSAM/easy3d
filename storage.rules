rules_version = '2';

// 메이커 페스티벌 행사용(festival01/, festival02/ 페이지) 제출 파일 규칙.
// - 참가자는 로그인 없이 페이지 번호와 같은 폴더에 "이름(소속)" 파일을 올리기만 할 수
//   있다. 01번은 두 색(흰 뚜껑+검정 글씨)이라 .3MF, 02번은 단색이라 .STL로 받는다.
//   같은 이름으로 다시 보내면 덮어쓴다(마지막으로 보낸 디자인이 남음).
//   (2026-10-15 전에는 "이름(핸드폰번호)"로 받았다 — 그때 올라온 파일 이름에는 번호가 있다.)
// - 파일 이름에 이름·소속이 들어가므로 읽기/목록 보기는 전부 막는다. 선생님은 Firebase
//   콘솔(Storage 메뉴)에 로그인해서 파일을 확인·내려받는다(콘솔은 이 규칙의 영향을 받지 않음).
// - 그 밖의 경로는 모두 막는다.
// - 2026-11-04 세 폴더 모두 받기를 닫았다. 다시 받으려면 그 폴더의 조건 주석을 되살려 규칙을 배포하고,
//   그 페이지의 SUBMIT_OPEN을 true로 바꿔 사이트도 배포한다(2026jjbs는 그쪽 저장소 push).
//   festival01은 설명 페이지(festival01/index.html)의 주석 안 글도 되살린다.
//   업로드 때 '제출기간이 아닙니다.'는 규칙에 막힐 때 나오므로 다시 연 뒤에도 10MB 초과면 나온다.
service firebase.storage {
  match /b/{bucket}/o {
    match /festival01/{fileName} {
      allow read: if false;
      // 닫음(2026-11-04). 다시 받을 때 조건: fileName.matches('.+[.]3MF') && request.resource.size > 0 && request.resource.size < 10 * 1024 * 1024
      allow create, update: if false;
    }
    match /festival02/{fileName} {
      allow read: if false;
      // 닫음(2026-11-04). 다시 받을 때 조건: fileName.matches('.+[.]STL') && request.resource.size > 0 && request.resource.size < 10 * 1024 * 1024
      allow create, update: if false;
    }
    // 2026jjbs(전주교대 부설초 연수 사이트)의 keycap/ 페이지 — 01번과 같은 두 색 .3MF, 파일 이름은 "이름(소속(학년반))".
    match /2026jjbs/{fileName} {
      allow read: if false;
      // 닫음(2026-11-04). 다시 받을 때 조건: fileName.matches('.+[.]3MF') && request.resource.size > 0 && request.resource.size < 10 * 1024 * 1024
      allow create, update: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
