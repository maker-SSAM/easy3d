rules_version = '2';

// 메이커 페스티벌 행사용(festival01/, festival02/ 페이지) 제출 파일 규칙.
// - 참가자는 로그인 없이 페이지 번호와 같은 폴더에 "이름(핸드폰번호)" 파일을 올리기만 할 수
//   있다. 01번은 두 색(흰 뚜껑+검정 글씨)이라 .3MF, 02번은 단색이라 .STL로 받는다.
//   같은 이름으로 다시 보내면 덮어쓴다(마지막으로 보낸 디자인이 남음).
// - 파일 이름에 핸드폰번호가 들어가므로 읽기/목록 보기는 전부 막는다. 선생님은 Firebase
//   콘솔(Storage 메뉴)에 로그인해서 파일을 확인·내려받는다(콘솔은 이 규칙의 영향을 받지 않음).
// - 그 밖의 경로는 모두 막는다.
service firebase.storage {
  match /b/{bucket}/o {
    match /festival01/{fileName} {
      allow read: if false;
      allow create, update: if fileName.matches('.+[.]3MF')
                            && request.resource.size > 0
                            && request.resource.size < 10 * 1024 * 1024;
    }
    match /festival02/{fileName} {
      allow read: if false;
      allow create, update: if fileName.matches('.+[.]STL')
                            && request.resource.size > 0
                            && request.resource.size < 10 * 1024 * 1024;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
